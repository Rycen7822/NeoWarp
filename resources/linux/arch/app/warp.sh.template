#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/neowarp-flags.conf ]]; then
    WARP_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/neowarp-flags.conf)"
fi

# Launch
exec /opt/neowarp/@@BINARY_NAME@@ $WARP_USER_FLAGS "$@"
